    "#Matrix Generation\n",
    "\n",
    "def matrix(dic):\n",
    "    all_rows=[]\n",
    "    for (drug, dt_set) in dic.items():\n",
    "        row_data = {'DrugName': drug}\n",
    "        for dt in dt_set:\n",
    "            row_data[dt] = 1\n",
    "        all_rows.append(row_data)\n",
    "    dt_df = pd.DataFrame(all_rows)\n",
    "    dt_df = dt_df.fillna(0)\n",
    "    dt_df = dt_df[dt_df['DrugName'].str.contains('DB')]\n",
    "    return dt_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [],
   "source": [

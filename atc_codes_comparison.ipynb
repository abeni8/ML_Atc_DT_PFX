   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# Load the data\n",
    "lr_anova_loaded = pd.read_excel(\"./LR_ANOVA_new.xlsx\")\n",
    "\n",
    "# Remove the first column and last two columns\n",
    "lr_anova_filtered = lr_anova_loaded.iloc[:, 1:-2]\n",
    "\n",
    "# Select the first five rows and the last row (average)\n",
    "lr_anova_display = pd.concat([lr_anova_filtered.iloc[:5], \n",
    "                              pd.DataFrame([[\"...\"] * len(lr_anova_filtered.columns)], columns=lr_anova_filtered.columns), \n",
    "                              lr_anova_filtered.iloc[[-1]]])\n",
    "\n",
    "# Create a table figure\n",
    "fig, ax = plt.subplots(figsize=(12, 4))\n",
    "ax.axis('tight')\n",
    "ax.axis('off')\n",
    "\n",
    "# Create the table\n",
    "table = ax.table(cellText=lr_anova_display.values, \n",
    "                 colLabels=lr_anova_display.columns, \n",
    "                 cellLoc='center', \n",
    "                 loc='center',\n",
    "                 colWidths=[0.15] * len(lr_anova_display.columns))  # Adjust column width\n",
    "\n",
    "# Styling: Increase font size and set cell colors\n",
    "table.auto_set_font_size(False)\n",
    "table.set_fontsize(10.5)\n",
    "\n",
    "# Bold and darken the header row\n",
    "header_color = '#bbd5fc' \n",
    "for j in range(len(lr_anova_display.columns)):\n",
    "    table[(0, j)].set_facecolor(header_color)\n",
    "    table[(0, j)].set_text_props(weight='bold')\n",
    "\n",
    "# Alternate row colors and set dots row\n",
    "for i in range(1, len(lr_anova_display)):\n",
    "    color = '#c7dcfc' if i % 2 == 0 else 'white'\n",
    "    for j in range(len(lr_anova_display.columns)):\n",
    "        table[(i, j)].set_facecolor(color)\n",
    "\n",
    "# Highlight the dots row\n",
    "dots_row_index = len(lr_anova_display) - 2  # Second to last row\n",
    "for j in range(len(lr_anova_display.columns)):\n",
    "    table[(dots_row_index, j)].set_facecolor('#e0e0e0')  # Gray for '...'\n",
    "\n",
    "# Save and show the figure\n",
    "plt.savefig(\"LR_ANOVA_table_filtered.png\", bbox_inches='tight', dpi=300)\n",
    "plt.show()\n"
   ]
  },
